# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Env — alleen backend\.env is lokaal, voorbeeld wel mee
# (backend\.env wordt niet mee-gecloned; kopieert automatisch uit .env.example)
backend/.env

# Audio output / cache
# Let op: NovaTTS levert zelf GEEN audio mee. Alle emotion fragments, TTS
# output en caches zijn lokaal. Zet je eigen bestanden in de map die je bij
# Instellingen > Emotion sounds instelt.
*.wav
*.ogg
*.opus
*.mp3
data/cache/

# Node / Tauri
node_modules/
dist/
target/

# OS
Thumbs.db
.DS_Store

# Crush (opencode session data)
.crush.json
.crush/

# Persoonlijke runtime-data — niet pushen
# Per-game stem-casting en Perfect Cut instellingen zijn lokaal
data/games/*/speakers.json
data/perfect_cut.json
# Het globale register: het speakers.json dat geldt wanneer er geen actieve
# game is (games.py, speakers_path()). Bevat echte stemmen van echte personen
# en is dus net zo persoonlijk als de per-game bestanden hierboven. De app
# maakt het zelf aan bij de eerste registratie, dus een verse clone mist het
# en dat is correct.
data/speakers.json
# Emotion mapping is per bibliotheek: de map met audio is lokaal en het map-bestand
# is een cache van die map. De app maakt ze zelf aan; zie de *.json.example ernaast.
data/emotion_sound_map.json
data/emotion_aliases.json

# Installer output
NovaTTS-Setup-*.exe
NovaTTS-Portable-*.zip
installer/Output/
*.log
backend/dist/
# Emitted by the composite tsconfig.node.json that svelte-check reads
# (gui/tsconfig.node.json); nothing consumes it, it only satisfies the
# composite project rule.
gui/.tsbuild/

backend/build/