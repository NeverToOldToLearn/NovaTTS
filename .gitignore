# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Env â€” alleen backend\.env is lokaal, voorbeeld wel mee
# (backend\.env wordt niet mee-gecloned; kopieert automatisch uit .env.example)
backend/.env

# Audio output / cache
# Emotion fragments, TTS output and caches are normally local. The one
# exception is the built-in emotion set: it ships with the app (small, openly
# licensed). Its single canonical location is data/emotion_sounds (read by the
# backend and bundled by the installer), whitelisted below.
*.wav
*.ogg
*.opus
*.mp3
!data/emotion_sounds/*.wav
!data/emotion_sounds/*.ogg
data/cache/

# Node / Tauri
node_modules/
dist/
target/

# OS
Thumbs.db
.DS_Store

# Crush (opencode session data)
.crush.json
.crush/

# Persoonlijke runtime-data â€” niet pushen
# Per-game stem-casting en Perfect Cut instellingen zijn lokaal
data/games/*/speakers.json
data/perfect_cut.json
# Welke game geselecteerd is en je eigen blacklist-woorden: lokaal,
# de app maakt ze zelf aan als ze ontbreken.
data/active_game.json
data/blacklist.json
# Standaard stem-casting (zonder actieve game): lokaal, wordt aangemaakt
# als hij ontbreekt.
data/speakers.json
# Emotion mapping is per bibliotheek: de map met audio is lokaal en het map-bestand
# is een cache van die map. De app maakt ze zelf aan; zie de *.json.example ernaast.
data/emotion_sound_map.json
data/emotion_aliases.json

# Installer output
NovaTTS-Setup-*.exe
NovaTTS-Portable-*.zip
# Grote lokale build-/backup-zips. Nooit committen: GitHub weigert bestanden
# groter dan 100 MB (GH001), en deze Artefacten horen niet in de repo.
NovaTTS-slim-*.zip
installer/Output/
*.log
backend/dist/
backend/build/
data/game_links.json

# Installer build staging + output (generated)
.build/
dist-installer/

# PyInstaller output at the repo root and one-off debug dumps. These are
# generated (run.exe alone is ~10 MB) and never belong in the repo.
/build/
novatts-auto-forward-404-error.json
