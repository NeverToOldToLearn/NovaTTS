{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NovaTTS",
  "version": "2.0.0",
  "identifier": "net.novatts.gui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NovaTTS",
        "width": 1200,
        "height": 800,
        "minWidth": 880,
        "minHeight": 560
      },
      {
        "label": "cutter",
        "title": "Perfect Cut — NovaTTS Sample Cutter",
        "url": "index.html#/cutter",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../backend/dist/novatts-backend.exe": "resources/novatts-backend.exe",
      "../../backend/.env.example": "resources/.env.example",
      "../../data": "data"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
