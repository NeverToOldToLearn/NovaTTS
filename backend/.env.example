# NovaTTS backend configuration (.env.example)
# Copy to .env and adjust.

NOVATTS_HOST=127.0.0.1
NOVATTS_PORT=8765

# qwentts.cpp server (local Qwen3-TTS GPU engine)
# Default 8080 (tts-server default). If that port is busy, start qwentts with --port 8081
# and set this to http://127.0.0.1:8081.
NOVATTS_QWEN_URL=http://127.0.0.1:8080
# Must match config.py's qwen_timeout default (300.0). A cold-cloned
# voice on a slow GPU legitimately takes minutes; 120 s was too tight.
NOVATTS_QWEN_TIMEOUT=300.0
# Leeg = ingebouwde modelstem; zet hier een gekloonde voice-naam om elke
# ongekoppelde speaker op die stem te zetten.
NOVATTS_QWEN_DEFAULT_VOICE=
NOVATTS_QWEN_BIN=D:\Projects\qwentts.cpp\build\Release\tts-server.exe
NOVATTS_QWEN_MODEL=E:\LLM's\Qwen3TTS\qwen-talker-1.7b-base-Q8_0.gguf
NOVATTS_QWEN_CODEC=E:\LLM's\Qwen3TTS\qwen-tokenizer-12hz-Q8_0.gguf
NOVATTS_QWEN_AUTOSTART=1
NOVATTS_QWEN_EXTRA_ARGS=--alias qwen3-tts
NOVATTS_QWEN_AUTO_IMPORT_SAMPLES=1
NOVATTS_QWEN_SAMPLES_DIR=D:\!!Scripts!!\Samples_Clone
# qwen-codec.exe voor het pre-extraheren van .spk/.rvq voice references
# (naast tts-server.exe in dezelfde build-map). Leeg = auto-detect.
NOVATTS_QWEN_CODEC_BIN=D:\Projects\qwentts.cpp\build\Release\qwen-codec.exe

# Clipboard polling (seconds; RenPy copy_voice_to_clipboard)
NOVATTS_POLL_INTERVAL=0.25
NOVATTS_MIN_TEXT_LENGTH=3

# ---------------------------------------------------------------------------
# Hook input (LunaTranslator / Textractor)
# ---------------------------------------------------------------------------
# Which raw_text source is active:
#   websocket  = LunaHook only  <-- the default
#   clipboard  = RenPy only (the legacy route, still fully supported)
#   both       = both side by side, first one to yield wins
# Anything else falls back to "both" with a warning, so a typo here cannot
# stop the backend from starting. Note that this fallback is deliberate and
# is NOT the default: when the setting is unreadable you want the most
# tolerant route, not the strictest.
NOVATTS_HOOK_MODE=websocket

# Two topologies; pick by what your hook does. By default NovaTTS *serves*
# the websocket here and your hook connects to it. If your hook is the
# server instead -- textractor_websocket is: it opens the socket itself on
# 6677 and pushes to whoever connects -- then set NOVATTS_LUNA_WS_URL below
# and NovaTTS will dial in. Leave translation OFF either way; NovaTTS only
# wants the raw text. Keep this on loopback; 0.0.0.0 would expose raw
# game text to the network.
NOVATTS_HOOK_HOST=127.0.0.1
NOVATTS_HOOK_PORT=6677

# Textractor sends "Rick It's 2 parts." (space form). Set to 0 only if
# your game uses the RenPy-style "Rick: It's 2 parts." -- NovaTTS tries
# the RenPy parser first regardless, so this is a fallback, not a switch.
NOVATTS_HOOK_SPACE_FORM=1

# Some games need the hook attached twice to capture every line. Doubles
# traffic; off by default.
NOVATTS_HOOK_DUAL_HOOK=0

# Optional outbound ws client instead of the built-in server.
# Empty = serve. Non-empty (e.g. ws://127.0.0.1:6678) = connect.
NOVATTS_LUNA_WS_URL=

# Tertiary route: tail a Textractor output file. Off by default; only
# useful when neither clipboard nor websocket is reachable.
# Independent of NOVATTS_HOOK_MODE: that flag chooses between clipboard and
# websocket, this one turns the fallback on or off.
# The file is read every ~0.3s and each NEW LINE is parsed as one line of
# dialogue, so a growing log and an overwritten scratch file both work.
# A writer that puts a name and its text on separate lines ("Rick" then
# "Answer the door.") loses the name unless NOVATTS_HOOK_DUAL_HOOK=1.
NOVATTS_FILE_WATCH=0
NOVATTS_FILE_WATCH_PATH=textractor_output.txt

# Ignore an identical line arriving within this window (ms). Textractor
# re-emits the same line on window change and on re-focus; 500 ms removes
# the stutter without swallowing a genuine repeat.
NOVATTS_DEDUP_WINDOW_MS=500

# Audio
NOVATTS_AUDIO_SAMPLE_RATE=22050
# Eén piekniveau voor elke gesynthetiseerde regel (F19). Uit = oude gedrag.
NOVATTS_NORMALIZE_AUDIO=true
NOVATTS_NORMALIZE_TARGET_PEAK=0.89

# Logging
NOVATTS_LOG_LEVEL=INFO