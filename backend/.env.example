# NovaTTS backend configuration (.env.example)
# Copy to .env and adjust.

NOVATTS_HOST=127.0.0.1
NOVATTS_PORT=8765

# qwentts.cpp server (local Qwen3-TTS GPU engine)
# Default 8080 (tts-server default). If that port is busy, start qwentts with --port 8081
# and set this to http://127.0.0.1:8081.
NOVATTS_QWEN_URL=http://127.0.0.1:8080
NOVATTS_QWEN_TIMEOUT=120.0
# Leeg = ingebouwde modelstem; zet hier een gekloonde voice-naam om elke
# ongekoppelde speaker op die stem te zetten.
NOVATTS_QWEN_DEFAULT_VOICE=
# Paden naar de Qwen-engine en modellen. De installer / AI-tools-repair vult
# deze automatisch met de build onder %LOCALAPPDATA%\NovaTTS\AI-Tools.
# Laat ze uitgecommentarieerd of leeg om de ingebouwde default te gebruiken.
#NOVATTS_QWEN_BIN=
#NOVATTS_QWEN_MODEL=
#NOVATTS_QWEN_CODEC=
NOVATTS_QWEN_AUTOSTART=1
NOVATTS_QWEN_EXTRA_ARGS=--alias qwen3-tts
NOVATTS_QWEN_AUTO_IMPORT_SAMPLES=1
#NOVATTS_QWEN_SAMPLES_DIR=
# qwen-codec.exe voor het pre-extraheren van .spk/.rvq voice references
# (naast tts-server.exe in dezelfde build-map). Leeg = auto-detect.
#NOVATTS_QWEN_CODEC_BIN=

# Clipboard polling (seconds; RenPy copy_voice_to_clipboard)
NOVATTS_POLL_INTERVAL=0.25
NOVATTS_MIN_TEXT_LENGTH=3

# Input: clipboard (RenPy), luna (LunaTranslator hook via websocket), of both.
# Luna levert de tekst rechtstreeks uit de game-hook, ook als het venster
# niet focus heeft. Vereist Luna's webserver (networktcpenable, poort 2333).
NOVATTS_HOOK_MODE=both
NOVATTS_LUNA_WS_URL=ws://127.0.0.1:2333/api/ws/text/origin
# In "both" komt dezelfde regel soms via beide routes binnen; de tweede
# binnen dit aantal seconden wordt genegeerd.
NOVATTS_HOOK_DEDUP_WINDOW=3.0
# RPG Maker bewaart sommige namen als nummer-placeholder: "\n[1]" / "\N[1]"
# is de naam van actor 1, zowel in de spreker-tag (<\c[14]\n[1]>) als
# midden in de zin ("I'm not leaving \n[1]'s side."). De echte spelling is
# per game anders; map de codes hier, bv. "1=Rick,2=Otsu". Leeg = placeholder
# wordt weggehaald en zo'n getagde regel krijgt de verteller-stem.
#NOVATTS_ACTOR_NAMES=1=Rick

# Audio
NOVATTS_AUDIO_SAMPLE_RATE=22050
# Eén piekniveau voor elke gesynthetiseerde regel (F19). Uit = oude gedrag.
NOVATTS_NORMALIZE_AUDIO=true
NOVATTS_NORMALIZE_TARGET_PEAK=0.89

# Logging
NOVATTS_LOG_LEVEL=INFO

# Live pcm-streaming (geen WAV-omweg): playback start zodra ~0.4s audio binnen
# is i.p.v. pas na de volledige synthese. Aan = merkbaar snellere lange zinnen.
NOVATTS_STREAMING_ENABLED=true
# Houd het output-device wakker met stilte (geen cold-start kraak op draadloos).
NOVATTS_KEEP_WARM_ENABLED=true
# Emotie-testmodus: spreek emotiewoorden uit als tekst ("haaa", "*laughs*")
# i.p.v. ze te filteren of door .wav-clips te vervangen. Uit = normaal gedrag.
#NOVATTS_EMOTION_SPEAK_WORDS=true